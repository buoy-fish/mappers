#!/usr/bin/env bash
# Test double for curl, used by post-deploy-check.test.sh.
# Serves fixtures from $CURL_STUB_DIR/<key>/{status,ctype,body}, where <key>
# is the URL path with '/' -> '_' (query string dropped; "/" -> "root").
# Supports only the flags post-deploy-check.sh uses: -o FILE and -w FORMAT.
# A missing fixture, or a call before $CURL_STUB_DIR/<key>/ready_after calls,
# behaves like a refused connection (exit 7, "000").
set -u
out=/dev/stdout fmt="" url=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o) out="$2"; shift 2 ;;
    -w) fmt="$2"; shift 2 ;;
    -H|--max-time|-m) shift 2 ;;
    http://*|https://*) url="$1"; shift ;;
    *) shift ;;
  esac
done
path="/${url#*://*/}"; [ "$url" = "${url#*://*/}" ] && path="/"
path="${path%%\?*}"
key="${path#/}"; key="${key//\//_}"; [ -z "$key" ] && key=root
dir="$CURL_STUB_DIR/$key"
calls=0; [ -f "$dir/calls" ] && calls=$(cat "$dir/calls")
[ -d "$dir" ] && echo $((calls + 1)) > "$dir/calls"
ready_after=0; [ -f "$dir/ready_after" ] && ready_after=$(cat "$dir/ready_after")
if [ ! -f "$dir/status" ] || [ "$calls" -lt "$ready_after" ]; then
  printf '%s' "${fmt//\%\{http_code\}/000}" | sed 's/%{content_type}//'
  exit 7
fi
cat "$dir/body" > "$out"
status=$(cat "$dir/status"); ctype=$(cat "$dir/ctype")
w="${fmt//\%\{http_code\}/$status}"; w="${w//\%\{content_type\}/$ctype}"
printf '%s' "$w"
