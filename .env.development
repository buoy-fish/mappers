# Buoy.Fish Coverage Mapper - Development Environment
# Used by: ./scripts/dev.sh and config/dev.exs
#
# All values below are sensible defaults. Override as needed for your local setup.

# Dev server port (default 4002 to avoid colliding with app.buoy.fish on 4000)
PORT=4002

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mappers_dev

# Per-project Timeline config (start date + default sweep speed), keyed by project code.
# Injected into the frontend build. Edit a project's "start" to fix its bloom start date.
TIMELINE_PROJECT_CONFIG='{"punta-eugenia-baja":{"start":"2026-04-15","speed":1},"punta-abreojos-baja":{"start":"2026-04-10","speed":1}}'
